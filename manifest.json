{
  "manifest_version": 3,
  "name": "Simple E2E Bridge",
  "version": "0.1",
  "description": "Encrypted messaging layer for web messengers.",
  "permissions": ["storage"],
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "E2E Bridge",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png"
    }
  }
}
